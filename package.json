{
  "name": "bm-electron-vite",
  "version": "6.0.0",
  "description": "Electron build tooling based on Vite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": {
      "types": "./node.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "electron-vite": "bin/electron-vite.js"
  },
  "files": [
    "bin",
    "dist",
    "node.d.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.34.9",
  "author": "hunghg255",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BM-Hospital/bm-electron-vite.git"
  },
  "bugs": {
    "url": "https://github.com/BM-Hospital/bm-electron-vite/issues"
  },
  "homepage": "https://github.com/BM-Hospital/bm-electron-vite#readme",
  "keywords": [
    "electron",
    "vite",
    "cli",
    "plugin"
  ],
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run lint && rolldown -c rolldown.config.ts",
    "test:bytecode": "node scripts/testBytecode.js",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:preview": "pnpm --filter ./docs serve"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verifyCommit.js $1"
  },
  "lint-staged": {
    "*.js": [
      "oxfmt"
    ],
    "*.ts?(x)": [
      "oxlint",
      "oxfmt"
    ]
  },
  "peerDependencies": {
    "@swc/core": "^1.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.5",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rolldown-plugin-dts": "^0.29.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "cac": "^7.1.0",
    "magic-string": "^1.4.5",
    "picocolors": "^1.1.1",
    "rolldown": "~1.2.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "simple-git-hooks"
    ]
  }
}
